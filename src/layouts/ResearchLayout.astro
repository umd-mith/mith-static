---
import type { CollectionEntry } from 'astro:content';
import PageLayout from './PageLayout.astro'
import { Image } from 'astro:assets';
import FigurePlaceHolder from '../components/FigurePlaceHolder.astro';
import { Mail, Globe } from '@lucide/astro';
import PubInfo from '../components/PubInfo.astro';

interface Props {
  entry: CollectionEntry<'research'>;
  active: string;
  showTitle?: boolean;
}

const { entry, active, showTitle = true } = Astro.props as Props;
const { data } = entry;
---

<PageLayout title={data.title} active={active} showTitle={showTitle}>
  {(showTitle && data.subtitle) && <h2>{data.subtitle}</h2>}
  <slot/>
  {data.image && data.image.length > 0 ? (
    <Image
      src={data.image[0].url}
      inferSize={true}
      loading="eager"
      alt={data["image alt"] || "Project logo or representative image."}
      class="w-full object-contain" />
  ) : <FigurePlaceHolder/>}
  <PubInfo url={`${active}/${data.slug}`}>
    <span>{data.active === "TRUE" && <div class="badge badge-xl badge-neutral">active</div>}
    <strong>{data["year start"]}
      {data["year end"] && (
        <span> – {data["year end"]}</span>
      )}
    </strong></span>
  </PubInfo>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <article class="col-span-2">
      <Fragment set:html={data.description} />
    </article>
    <aside class="px-6">
      {data["linked directors"] && data["linked directors"].length > 0 &&
      <h2 class="text-[1.5em] mt-6 mb-[0.6em] leading-2.5 font-semibold">Directors</h2>
      <ul class="list list-none p-0">
        {data["linked directors"]?.map((director, i) => (
          <li>{director["group type"].includes("Staff")
            ? <a href={`/people/${director.slug}`} class="font-bold">{director.name}</a>
            : <strong>{director.name}</strong>
          }<br/>
          {data["linked director affiliations"]?.[i] && data["linked director affiliations"]?.[i]["full affiliation"]}
          </li>
        ))}
      </ul>}
      {data["linked participants"] && data["linked participants"].length > 0 &&
      <h2 class="text-[1.5em] mt-[1em] mb-[0.6em] leading-2.5 font-semibold">Participants</h2>
      <ul class="list list-none p-0">
        {data["linked participants"]?.filter(p => p["group type"].includes("Staff") || p["group type"].includes("Past")).map((participant, i) => (
          <li>
            <strong>{participant.name}</strong><br/>
            {data["linked internal participant affiliations"]?.[i] && data["linked internal participant affiliations"]?.[i]["full affiliation"]}
          </li>
        ))}
        {data["linked participants"]?.filter(p => !p["group type"].includes("Staff") && !p["group type"].includes("Past")).map((participant, i) => (
          <li>
            <strong>{participant.name}</strong><br/>
            {data["linked external participant affiliations"]?.[i] && data["linked external participant affiliations"]?.[i]["full affiliation"]}
          </li>
        ))}
      </ul>}
      {data["linked links"] && data["linked links"].length > 0 &&
      <h2 class="text-[1.5em] mt-[1em] mb-[0.6em] leading-2.5 font-semibold"Links</h2>
      <ul class="list list-none p-0">
        {data["linked links"]?.map(l => (
          <li>
            <a href={l.url}>{l.title}</a>
          </li>
        ))}
      </ul>
      }
      {data["linked posts"] && data["linked posts"].length > 0 &&
      <h2 class="text-[1.5em] mt-[1em] mb-[0.6em] leading-2.5 font-semibold"News</h2>
      <ul class="list list-none p-0">
        {data["linked posts"]?.map(l => (
          <li>
            <a href={`/news/${l.slug}`}>{l["post title"]}</a>
            <br/>{new Date(l["post date"]).toLocaleDateString()}
          </li>
        ))}
      </ul>
      }
      {data["linked partners"] && data["linked partners"].length > 0 &&
      <h2 class="text-[1.5em] mt-[1em] mb-[0.6em] leading-2.5 font-semibold"Partners</h2>
      <ul class="list list-none p-0">
        {data["linked partners"]?.map(l => (
          <li>
            <a href={l.website}>{l.name}</a>
          </li>
        ))}
      </ul>
      }
      {data["linked sponsors"] && data["linked sponsors"].length > 0 &&
      <h2 class="text-[1.5em] mt-[1em] mb-[0.6em] leading-2.5 font-semibold"Sponsors</h2>
      <ul class="list list-none p-0">
        {data["linked sponsors"]?.map(l => (
          <li>
            <a href={l.website}>{l.name}</a>
          </li>
        ))}
      </ul>
      }
    </aside>
  </div>

</PageLayout>