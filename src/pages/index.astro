---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { getImage } from 'astro:assets';
import MITHCoffee from '../assets/images/mith-coffee.jpg';

const pages = await getCollection('pages');
const entry = pages.find((e: CollectionEntry<'pages'>) => e.data.slug === 'index');
if (!entry) throw new Error('No index entry found in pages collection');

const { Content } = await render(entry);

const labs = await getCollection('labs');
const activeResearch = (await getCollection('research')).filter(r => r.data.active === 'TRUE');
const pastResearch  = (await getCollection('research')).filter(r => r.data.active === 'FALSE');

interface Payload { title: string; slug: string; image?: string; alt?: string }

const placeholderImg = await getImage({ src: MITHCoffee });

const getImageSrc = async (url: string | undefined): Promise<string> => {
  if (!url) return placeholderImg.src;
  const img = await getImage({ src: url, inferSize: true, });
  return img.src;
};

const activePayload: Payload[] = await Promise.all([
  ...labs.map(async e => ({
    title: e.data.title,
    slug: e.data['external link'] || `/labs/${e.data.id}`,
    image: await getImageSrc(e.data.image?.[0]?.url),
    alt: e.data['image alt'] ?? 'Project logo or representative image.',
  })),
  ...activeResearch.map(async e => ({
    title: e.data.title,
    slug: `/research/${e.data.id}`,
    image: await getImageSrc(e.data.image?.[0]?.url),
    alt: e.data['image alt'] ?? 'Project logo or representative image.',
  })),
]);

const archivePayload: Payload[] = await Promise.all(
  pastResearch.map(async e => ({
    title: e.data.title,
    slug: `/archive/${e.data.id}`,
    image: await getImageSrc(e.data.image?.[0]?.url),
    alt: e.data['image alt'] ?? 'Project logo or representative image.',
  }))
);
---

<PageLayout title={entry.data.title} active="index" showTitle={false} titleSrOnly={true}>
  <div class="grid grid-cols-1 sm:grid-cols-2">
    <section><Content /></section>
    <section class="justify-self-end not-prose">
      <div class="card bg-base-100 w-96 shadow-sm mb-8">
        <figure class="h-40" id="rl-card-img">
        </figure>
        <div class="card-body">
          <h2 class="card-title"><a href="/research">Research & Labs</a></h2>
          <p class="pb-4">Learn more about our research initiatives and programs like <span id="rl-card-name"></span></p>
          <div class="card-actions justify-end">
            <a class="btn btn-accent text-base-content" href="/research">Explore Research & Labs</a>
          </div>
        </div>
      </div>
      <div class="card bg-base-100 w-96 shadow-sm">
        <figure class="h-40" id="archive-card-img">
        </figure>
        <div class="card-body">
          <h2 class="card-title">From the Archive</h2>
          <p class="pb-4">MITH has been leading Digital Humanities research at the University of Maryland for over 20 years. 
            Explore our archive of resources and past events, such as <span id="archive-card-name"></span></p>
          <div class="card-actions justify-end">
            <a class="btn btn-accent text-base-content" href="/archive">Explore the Archive</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<script define:vars={{ activePayload, archivePayload }}>
  function escapeHTML(str) {
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '/': '&#x2F;'
    };
    const reg = /[&<>"'/]/g;
    return str.replace(reg, (match) => map[match]);
  }
  const activePick = activePayload[Math.floor(Math.random() * activePayload.length)];
  document.getElementById("rl-card-img").innerHTML = `<img src="${activePick.image}" alt="${escapeHTML(activePick.alt)}"/>`
  document.getElementById("rl-card-name").innerHTML = `<a href="${activePick.slug}" class="link">${escapeHTML(activePick.title)}</a>`

  const archivePick = archivePayload[Math.floor(Math.random() * archivePayload.length)];
  document.getElementById("archive-card-img").innerHTML = `<img src="${archivePick.image}" alt="${escapeHTML(archivePick.alt)}"/>`
  document.getElementById("archive-card-name").innerHTML = `<a href="${archivePick.slug}" class="link">${escapeHTML(archivePick.title)}</a>`
</script>