---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import { CalendarFold, MapPinned } from '@lucide/astro';
import { date } from 'astro:schema';
import PubInfo from '../../components/PubInfo.astro';

export async function getStaticPaths() {
  const pages = await getCollection('events');

  return pages
    .filter(e => new Date(e.data['end date']).getTime() < new Date().getTime())
    .map((entry: CollectionEntry<'events'>) => ({
      params: { slug: entry.data.id },
      props: { entry },
    }));
}

interface Props {
  entry: CollectionEntry<'events'>;
}

const { entry } = Astro.props as Props;
const { data } = entry;
---

<PageLayout title={data["event title"]} active="archive" showTitle={false}>
  <div class="breadcrumbs text-sm not-prose pb-8">
    <ul>
      <li><a href="/archive">Archive</a></li>
      <li><a href="/events/1">Past Events</a></li>
    </ul>
  </div>
  <h1>{data["event title"]}</h1>
  <PubInfo url={`events/${data.id}`}>
    <div><p class="mb-0 flex gap-2 items-center">
      <CalendarFold />
      <span>{new Date(data["start date"]).toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      })} – {new Date(data["end date"]).toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      })}</span>
    </p>
    <p class="italic mt-0 flex gap-2 items-center">
      <MapPinned />
      {data.location}
    </p></div>
  </PubInfo>
  {data.image?.[0] &&
    <figure>
      <Image
        src={data.image?.[0].url}
        inferSize={true}
        loading="eager"
        alt={data['image alt'] || 'Something representative of this event.'}
        class="w-full object-contain" />
    </figure>
  }
  <div class="grid grid-cols-1 sm:grid-cols-2 not-prose">{data.speakers?.map((sp, i) => (
    <div class="card bg-base-100 w-96 shadow-sm">
      {sp.headshot?.[0] &&
        <figure>
          <Image
            src={sp.headshot?.[0].url}
            inferSize={true}
            loading="eager"
            alt={`Headshot of ${sp.name}`}
            class="w-full object-contain" />
        </figure>
      }
      <div class="card-body">
        <h2 class="card-title">{sp.name}</h2>
        {data['speaker affiliations'] && 
          <p class="italic">{data['speaker affiliations'][i] && data['speaker affiliations'][i]['full affiliation']}</p>
        }
        <div class="card-actions justify-start">
          {sp.website && <a href={sp.website} class="btn btn-accent text-base-content">Website</a>}
          {sp.bio && <a href={`#${sp.slug}`} class="btn btn-accent text-base-content">Read bio</a>}
        </div>
      </div>
    </div>
  ))}</div>
  <article set:html={data.description} />
  {data['speakers']?.map((sp) => (
    <hr/>
    <div id={sp.slug} set:html={sp.bio}/>
  ))}
  {data["linked links"] && data["linked links"].length > 0 &&
    <h2>Resources</h3>
    <ul class="list list-none p-0">
      {data["linked links"]?.map(l => (
        <li>
          <a href={l.url}>{l.title}</a>
        </li>
      ))}
    </ul>
  }
  {data.partners && data.partners.length > 0 &&
    <h2>Partners</h3>
    <ul class="list list-none p-0">
      {data.partners?.map(p => (
        <li>
          {p.website 
            ? <a href={p.website}>{p.name}</a>
            : p.name
          }
        </li>
      ))}
    </ul>
  }
  {data.sponsors && data.sponsors.length > 0 &&
    <h2>Sponsors</h3>
    <ul class="list list-none p-0">
      {data.sponsors?.map(p => (
        <li>
          {p.website 
            ? <a href={p.website}>{p.name}</a>
            : p.name
          }
        </li>
      ))}
    </ul>
  }
  {data["linked posts"] && data["linked posts"].length > 0 &&
    <h2>Related News</h3>
    <ul class="list list-none p-0">
      {data["linked posts"]?.map(l => (
        <li>
          <a href={`/news/${l.slug}`}>{l["post title"]}</a>
          <br/>{new Date(l["post date"]).toLocaleDateString()}
        </li>
      ))}
    </ul>
  }
  </div>
</PageLayout>
