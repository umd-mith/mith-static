---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import DD from '../../assets/images/dd.jpg';
import WA from '../../assets/images/webarchive.png';
import MITHCoffee from '../../assets/images/mith-coffee.jpg';
import MITHOldHeader from '../../assets/images/mith-pattern-header.png';
import PageLayout from '../../layouts/PageLayout.astro';

const pages = await getCollection('pages');
const entry = pages.find((e: CollectionEntry<'pages'>) => e.data.slug === 'archive');
if (!entry) throw new Error('No archive entry found in pages collection');

const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} active="archive">
  <Content />
  <section class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
    <div class="card bg-base-100 w-full shadow-sm">
      <figure class="h-80">
        <a href="/digital-dialogues" aria-hidden="true" tabindex="-1" class="block w-full h-full">
          <Image
            src={DD}
            loading="eager"
            alt=""
            class="w-full h-full object-cover" />
        </a>
      </figure>
      <div class="card-body">
        <h2 class="card-title"><a href="/digital-dialogues">Digital Dialogues</a></h2>
        <p>Digital Dialogues were MITH’s signature events program for over a decade, held almost every week during academic semesters. Digital Dialogues provided an occasion for discussion, presentation, and intellectual exchange. Discover the full record of Digital Dialogues events, including videos and materials, in the <a href="/digital-dialogues"  class="link">Digital Dialogues Archive</a>.</p>
      </div>
    </div>
    <div class="card bg-base-100 w-full shadow-sm">
      <figure class="h-80">
        <a href="./past-research" aria-hidden="true" tabindex="-1" class="block w-full h-full">
          <Image
            src={MITHOldHeader}
            loading="eager"
            alt=""
            class="w-full h-full object-fit" />
        </a>
      </figure>
      <div class="card-body">
        <h2 class="card-title"><a href="/past-research">Past Research Projects</a></h2>
        <p>Explore past research projects organized by topic, methods, and disciplines.</p>
      </div>
    </div>
    <div class="card bg-base-100 w-full shadow-sm">
      <figure class="h-80">
        <a href="https://archive.mith.umd.edu" aria-hidden="true" tabindex="-1" class="block w-full h-full">
          <Image
            src={WA}
            loading="eager"
            alt=""
            class="w-full h-full object-fit" />
        </a>
      </figure>
      <div class="card-body">
        <h2 class="card-title"><a href="https://archive.mith.umd.edu">MITH Web Archive</a></h2>
        <p>MITH Web Archive is a curated archive of legacy Digital Humanities research projects developed by MITH between approximately 2005–2020. These sites are preserved as historical scholarly artifacts and are no longer actively maintained or updated. They reflect historically specific platforms, design conventions, and technical infrastructures.</p>
      </div>
    </div>
    <div class="card bg-base-100 w-full shadow-sm">
      <figure class="h-80">
        <a href="/events/1" aria-hidden="true" tabindex="-1" class="block w-full h-full">
          <Image
            src={MITHCoffee}
            loading="eager"
            alt=""
            class="w-full h-full object-fit" />
        </a>
      </figure>
      <div class="card-body">
        <h2 class="card-title"><a href="/events/1">Past Events</a></h2>
        <p>Explore MITH’s record of past events.</p>
      </div>
    </div>
  </section>
</PageLayout>