---
import { Search } from "@lucide/astro/icons";
import { Image } from 'astro:assets'
import MITHLogoBlk from '../assets/images/MITH-logostack-blk.svg';
---
<button class="h-16 flex items-center btn btn-ghost hover:border-transparent hover:bg-transparent hover:shadow-none hover" onclick="searchModal.showModal()" aria-label="Search this site">
  <Search/>
</button>
<dialog id="searchModal" class="modal">
  <div class="modal-box cursor-default relative max-w-4xl p-0 max-md:h-[85vh] md:mt-[10vh] md:h-[clamp(13rem,80vh,80vh)] md:w-11/12">
    <div class="rounded-box h-full overflow-y-auto [scrollbar-width:thin]" style="scroll-padding-top: 3.5rem;">

      <span class="input input-lg 2xl:input-xl bg-base-100 border-base-300 sticky top-0 z-1 mb-2 w-full rounded-none border-0 border-b shadow-none 
      focus-within:shadow-none focus-within:outline-none 2xl:px-6">
        <Search/>
        <input id="searchInput" type="text" autocomplete="off" placeholder="Type to search..."> <span class="badge badge-xs" id="totResults"></span>
      </span>

      <!-- Results Container -->
      <div class="p-4">
        <div class="flex items-center justify-center min-h-[50vh]" id="emptySearch">
          <Image
            src={MITHLogoBlk}
            alt="Scholarly Editing logo"
            class="w-50"
            loading="lazy" />
        </div>
        <div id="searchResults"/>
        <!-- Results will appear here -->
      </div>

    </div>    
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script is:inline>
  let pagefind;

  async function initPageFind() {
    pagefind = await import("/pagefind/pagefind.js");
    await pagefind.options({
      showImages: false
    });
  }

  const searchInput = document.getElementById('searchInput');
  const searchResults = document.getElementById('searchResults');
  const totResults = document.getElementById('totResults');

  searchInput?.addEventListener('input', async (e) => {
    const query = e.target.value;
    
    if (!query) {
      searchResults.innerHTML = '';
      totResults.textContent = '';
      document.getElementById('emptySearch').style.display = 'flex';
      return;
    }

    document.getElementById('emptySearch').style.display = 'none';
    await initPageFind();
    const search = await pagefind.search(query);
    
    searchResults.innerHTML = '';

    if (search.results.length === 0) {
      searchResults.innerHTML = '<p class="text-base-content/60">No results found</p>';
      totResults.textContent = 'No results';
      return;
    }

    totResults.textContent = `${search.results.length} results`;

    for (const result of search.results) {
      const data = await result.data();
      
      const resultDiv = document.createElement('div');
      resultDiv.className = 'mb-4 p-3 hover:bg-base-200 rounded-lg cursor-pointer';
      resultDiv.innerHTML = `
        <a href="${data.url}" class="block">
          <h3 class="font-bold text-lg">${data.meta.title || 'Untitled'}</h3>
          <p class="text-sm text-base-content/70 mt-1">${data.excerpt}</p>
        </a>
      `;
      
      searchResults.appendChild(resultDiv);
    }
  });

  document.addEventListener("astro:page-load", initPageFind);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPageFind);
  } else {
    initPageFind();
  }

</script>
