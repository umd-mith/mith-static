---
import ThemeController from "../components/ThemeController.astro";
import { Menu } from "@lucide/astro";
import menuItems from "../data/nav.json";
import SearchModal from "./SearchModal.svelte";

const { active } = Astro.props;
---

<nav class="py-0 sticky top-0 z-50 border-y border-base-content/20 bg-base-100 my-8 h-16">
  <div class="grid max-w-7xl mx-8 grid-cols-2
    2xl:grid-cols-[1fr_var(--container-5xl)_1fr] 2xl:mx-auto 2xl:max-w-full
    ">
    <ol class="lg:flex hidden 2xl:col-start-2 justify-between h-16">
      {menuItems.map(item => 
        <li>
          <a class={`
          flex h-16 items-center transition duration-500 ease-in-out border-b-6 uppercase cursor-pointer text-2xl
          hover:border-accent outline-0 
          ${'/' + active === item.href ? 'border-accent focus:border-gray-600 focus-visible:border-gray-600'
          : 'focus:border-accent focus-visible:border-accent border-transparent'}`}
          href={item.href}>{item.name}</a>
        </li>
      )}
    </ol>
    <div class="flex col-start-2 2xl:col-start-3 justify-end gap-4 cursor-pointer pr-4 h-16">
      <div class="lg:hidden h-16 flex items-center">
        <input id="nav-drawer" type="checkbox" class="drawer-toggle" />
        <div class="lg:hidden">
          <label for="nav-drawer" class="btn btn-square btn-ghost">
            <Menu />
            <span class="sr-only">open sidebar navigation</span>
          </label>
        </div>
        <div class="drawer-side">
          <label for="nav-drawer" class="drawer-overlay">
            <span class="sr-only">close sidebar navigation</span>
          </label>
          <ol class="menu bg-base-100 w-screen p-4 mt-28 text-2xl leading-20 sm:grid sm:grid-cols-2 sm:gap-2">
            {menuItems.map(item => 
              <li><a class={`uppercase hover:text-accent px-4 py-2 inline-block cursor-pointer ${'/' + active === item.href ? 'text-accent' : 'hover:text-accent'} `} href={item.href}>{item.name}</a></li>
            )}
          </ol>
        </div>
      </div>
      <SearchModal client:load/>
      <ThemeController/>
    </div>
  </div>
</nav>
